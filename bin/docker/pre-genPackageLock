#!/usr/bin/bash

main() {
    local service="$1"

    case "$service" in
        "express");;
        "vite");;
        *)
            echo "Invalid service: ${service}" >&2
            exit 1;;
    esac

    pushd ~/MERN

    docker run --rm -v "./${service}":/app -w /app node:22-alpine \
        sh -c "npm install --package-lock-only"

    popd
    exit 0
}

main "$@"
